rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Images are stored under posts/{userId}/...
    // The userId segment in the path must match the signed-in user's UID.
    match /posts/{userId}/{allPaths=**} {
      // Any signed-in user can read images (needed to display other users' posts)
      allow read: if request.auth != null;

      // Only the user whose UID matches the path can upload or delete their images
      allow write: if request.auth != null
                   && request.auth.uid == userId;
    }

  }
}
